# Only publish the explicitly maintained collection.
/*
!/.gitignore
!/README.md
!/skills/
!/tests/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
.venv/
*.ttf
*.ttc
*.otf

# Workspace-only skill entry; keep other local skills untracked.
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/worksheet-dual-doc
